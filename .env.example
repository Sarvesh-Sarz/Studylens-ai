# --- LLM configuration ---
# Your Gemini API key. Required to generate answers. Never commit a real key.
GEMINI_API_KEY=

# Gemini model used for answer generation.
GEMINI_MODEL=gemini-2.5-flash

# --- Embedding configuration ---
# Sentence-transformers model used for semantic search.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Chunking configuration ---
# Target characters per chunk.
CHUNK_SIZE=1000

# Overlap (in characters) between consecutive chunks.
CHUNK_OVERLAP=150

# --- Retrieval configuration ---
# Number of chunks to retrieve per question.
TOP_K=5

# Optional: minimum similarity score to keep a retrieved chunk (0 disables filtering).
MIN_RELEVANCE_SCORE=0.0

# --- Conversation configuration ---
# Number of recent user/assistant turns included when resolving follow-up questions.
MAX_HISTORY_TURNS=6
